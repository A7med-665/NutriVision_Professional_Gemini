PORT=8080
NODE_ENV=development
# Set to a comma-separated list of exact app origins for production; don't use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USDA_API_KEY=
# LOCAL DEVELOPMENT ONLY: false lets you test the local API without Firebase Admin credentials.
# Do not expose this server to the internet while false. Production must use true.
REQUIRE_FIREBASE_AUTH=false
# For authenticated API testing, set REQUIRE_FIREBASE_AUTH=true and configure Firebase Admin:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_USER/secrets/nutrivision-service-account.json
